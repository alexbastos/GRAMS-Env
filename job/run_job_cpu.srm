#!/bin/bash
set -euo pipefail

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=sequana_cpu
#SBATCH --job-name=grams_cpu
#SBATCH --cpus-per-task=42
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=job_grams_cpu_%j.out
#SBATCH --error=job_grams_cpu_%j.err


# Diretório do projeto no Scratch
WORKING_DIR="/scratch/ufsj/hpc4agents-br/iago.oliveira3/GRAMS-Env"
CONDA_ENV_PREFIX="${WORKING_DIR}/.venv"
export PYTHON_BIN="${CONDA_ENV_PREFIX}/bin/python"

cd "${WORKING_DIR}" || exit 1


# Mostra o nó utilizado
scontrol show hostnames "${SLURM_NODELIST}"


# Carrega os módulos do ambiente
module purge
module load anaconda3/2024.02_sequana


# Carrega o suporte ao conda para disponibilizar bibliotecas dinâmicas do módulo,
# mas a execução do projeto usa PYTHON_BIN absoluto para não depender de PATH.
source /scratch/app_sequana/anaconda3/2024.02/etc/profile.d/conda.sh
conda activate "${CONDA_ENV_PREFIX}" || true

if [ ! -x "${PYTHON_BIN}" ]; then
    echo "❌ PYTHON_BIN não existe ou não é executável: ${PYTHON_BIN}"
    exit 1
fi

# Diagnóstico explícito: se o job estiver usando o Python errado, isso aparece
# no .out/.err antes de iniciar o treinamento.
echo "CONDA_DEFAULT_ENV=${CONDA_DEFAULT_ENV:-<unset>}"
echo "CONDA_PREFIX=${CONDA_PREFIX:-<unset>}"
echo "Python no PATH: $(command -v python || true)"
echo "PYTHON_BIN=${PYTHON_BIN}"
"${PYTHON_BIN}" --version
conda info --envs
"${PYTHON_BIN}" -c "import gymnasium; print('gymnasium version:', gymnasium.__version__)"
"${PYTHON_BIN}" -c "import torch; print('torch version:', torch.__version__)"


# Evita oversubscription: cada subprocesso do AsyncVectorEnv/NumPy usa 1 thread.
# Sem isso, 32 ambientes podem virar centenas de threads BLAS/OpenMP competindo
# pelos mesmos 42 núcleos do nó.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export BLIS_NUM_THREADS=1

# Configuração do treinamento CPU vetorizado da GNN.
# Em nó com 42 núcleos, 32 ambientes deixam folga para o processo principal,
# PyTorch, logging e overhead do sistema.
export GRAMS_NUM_ENVS=32
export GRAMS_TORCH_THREADS=4
export PYTHONUNBUFFERED=1


echo "OMP_NUM_THREADS=${OMP_NUM_THREADS}"
echo "MKL_NUM_THREADS=${MKL_NUM_THREADS}"
echo "OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS}"
echo "GRAMS_NUM_ENVS=${GRAMS_NUM_ENVS}"
echo "GRAMS_TORCH_THREADS=${GRAMS_TORCH_THREADS}"


# Executa o experimento
srun ./run_training.sh -d cpu
